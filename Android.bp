cc_library_shared {
    name: "libanemo_native",
    srcs: [
        "app/src/main/cpp/native_memory.c",
    ],
    sdk_version: "current",
    stl: "none",
}

android_app {
    name: "anemo",
    manifest: "app/src/main/AndroidManifest.xml",
    sdk_version: "36",
    srcs: [
        "app/src/main/java/exe/bbllw8/anemo/**/*.java",
    ],
    resource_dirs: [
        "app/src/main/res",
    ],
    optimize: {
        proguard_flags_files: [
            "app/proguard-rules.pro",
        ],
    },
    static_libs: [
        "androidx.annotation_annotation",
        "anemo-lib-either",
    ],
    jni_libs: ["libanemo_native"],
}

java_import {
    name: "anemo-lib-either",
    jars: ["libs/either-3.4.0.jar"],
    sdk_version: "current",
}

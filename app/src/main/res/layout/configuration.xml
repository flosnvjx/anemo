<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <Switch
            android:id="@+id/configuration_show_shortcut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_shortcut"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_protection"
            android:textColor="?android:attr/colorAccent" />

        <TextView
            android:id="@+id/configuration_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            tools:text="@string/configuration_storage_lock" />

        <TextView
            android:id="@+id/configuration_password_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            tools:text="@string/configuration_password_set" />

        <Switch
            android:id="@+id/configuration_biometric_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_storage_unlock_biometric"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_storage_section"
            android:textColor="?android:attr/colorAccent" />

        <Switch
            android:id="@+id/configuration_thumbnails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_thumbnails"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/configuration_thumbnail_extensions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:paddingStart="32dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="@string/configuration_thumbnail_extensions" />

        <TextView
            android:id="@+id/configuration_thumbnail_max_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:paddingStart="32dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="@string/configuration_thumbnail_max_size" />

        <Switch
            android:id="@+id/configuration_io_meter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_io_meter"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/configuration_io_meter_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:paddingStart="32dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="@string/configuration_io_meter_interval" />

        <TextView
            android:id="@+id/configuration_storage_quota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            tools:text="@string/configuration_storage_quota" />

        <TextView
            android:id="@+id/configuration_storage_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            tools:text="@string/configuration_storage_usage" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_battery_optimization"
            android:textColor="?android:attr/colorAccent" />

        <TextView
            android:id="@+id/configuration_battery_optimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            tools:text="@string/configuration_battery_optimization" />

        <TextView
            android:id="@+id/configuration_oem_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_oem_section"
            android:textColor="?android:attr/colorAccent"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/configuration_oem_autostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingHorizontal="16dp"
            android:text="@string/configuration_oem_autostart"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/configuration_oem_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:text="@string/configuration_oem_hint"
            android:textColor="?android:textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>

